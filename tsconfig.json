{
    "compilerOptions": {
        "target": "ES2015",
        "lib": ["ES2016", "DOM"],
        "module": "commonjs",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "removeComments": true,
        "declaration": true,
        "rootDir": "src",
        "outDir": "dist"
    },
    "include": ["src"],
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "Recommended"
}