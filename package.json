{
  "name": "mial",
  "version": "1.2.0",
  "main": "dist/mial.js",
  "license": "MIT",
  "devDependencies": {
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "prepublish": "pnpm run download-tlds && pnpm run build",
    "build": "tsc && tsc --emitDeclarationOnly --removeComments false",
    "download-tlds": "node scripts/downloadTlds.mjs",
    "update-resolvers": "tsc && node scripts/updateResolvers.mjs",
    "test": "tsc && jest --silent false",
    "test:live": "tsc && MIAL_LIVE_DNS=https://cloudflare-dns.com/dns-query jest dns.live"
  },
  "packageManager": "pnpm@12.10.1",
  "description": "A library designed to suggest better email domains and reduce errors effectively.",
  "keywords": [
    "email",
    "recommendation",
    "domains",
    "dns",
    "mx"
  ],
  "author": "coffeemakr <github@unstable.ch>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coffeemakr/mial.git"
  },
  "files": [
    "dist"
  ],
  "types": "dist/mial.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mial.d.ts",
      "default": "./dist/mial.js"
    },
    "./domains": {
      "types": "./dist/domains.d.ts",
      "default": "./dist/domains.js"
    },
    "./dns": {
      "types": "./dist/dns.d.ts",
      "default": "./dist/dns.js"
    },
    "./tlds": {
      "types": "./dist/tlds.d.ts",
      "default": "./dist/tlds.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  }
}
